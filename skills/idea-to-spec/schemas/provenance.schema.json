{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idea-to-spec.local/schemas/provenance.schema.json",
  "title": "Idea to Spec provenance",
  "type": "object",
  "required": ["schema_version", "project", "updated_at", "entries"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "source_type", "source_uri", "checked_at", "evidence_level", "confidence", "status", "linked_ids"],
        "properties": {
          "id": { "type": "string", "pattern": "^EVID-[A-Za-z0-9.-]+$" },
          "claim": { "type": "string", "minLength": 1 },
          "source_statement": { "type": "string" },
          "inference": { "type": ["string", "null"] },
          "source_type": { "type": "string", "minLength": 1 },
          "source_uri": { "type": "string", "minLength": 1 },
          "publisher": { "type": ["string", "null"] },
          "published_at": { "type": ["string", "null"] },
          "checked_at": { "type": "string", "minLength": 1 },
          "jurisdiction": { "type": ["string", "null"] },
          "evidence_level": { "enum": ["A", "B", "C", "D", "E"] },
          "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
          "status": { "enum": ["active", "superseded", "disputed", "obsolete"] },
          "linked_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
