{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idea-to-spec.local/schemas/approval-policy.schema.json",
  "title": "Idea to Spec approval policy",
  "type": "object",
  "required": ["schema_version", "project", "gates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {"type": "string", "minLength": 1},
    "gates": {"type": "array", "items": {"type": "object", "required": ["gate_id", "purpose", "version", "required_roles", "rule", "quorum", "status"], "properties": {
      "gate_id": {"type": "string", "pattern": "^GATE-[A-Za-z0-9.-]+$"}, "purpose": {"enum": ["SCOPE", "FINAL_SPEC", "CHANGE_REQUEST", "BASELINE", "HANDOFF"]}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "required_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "rule": {"enum": ["SINGLE", "ALL", "ANY", "N_OF_M"]}, "quorum": {"type": "integer", "minimum": 1}, "status": {"enum": ["DRAFT", "ACTIVE", "RETIRED"]}
    }, "additionalProperties": false}}
  },
  "additionalProperties": false
}
